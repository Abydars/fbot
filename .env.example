# Rename this file to .env and fill in your values.
# Never commit .env to version control.

# MT5 / Exness credentials
EXNESS_ACCOUNT=123456789
EXNESS_PASSWORD=your_password_here
EXNESS_SERVER=Exness-MT5Trial

# "demo" or "live"
TRADING_MODE=demo

# Symbol suffix used by your broker (leave blank for auto-detection).
# If startup logs show "Symbols not found", check what names appear in
# MT5 Market Watch and set the suffix here. e.g. SYMBOL_SUFFIX=m
SYMBOL_SUFFIX=
